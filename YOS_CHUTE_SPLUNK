// ==UserScript==
// @name         YOS & SPLUNK Sync Overlay - TESTO
// @namespace    http://tampermonkey.net/
// @version      1.2
// @description  Sincronizzazione tra Splunk Chute Scans e Plancia YOS (Ricerca Flessibile "Lenient"). Fix conflitti YOS Tool (ID tnt-).
// @author       Lorenzo Scurati (Fixed)
// @match        *://*/*
// @updateURL    https://raw.githubusercontent.com//LorenzoScurati/publicfede/main/YOS%20CHUTE%20SPLUNK
// @downloadURL  https://raw.githubusercontent.com//LorenzoScurati/publicfede/main/YOS%20CHUTE%20SPLUNK
// @grant        GM_setValue
// @grant        GM_getValue
// ==/UserScript==

(function() {
    'use strict';

    // ELENCO TEORICO SPLUNK AGGIORNATO
    const ELENCO_CHUTE_TEORICHE = [
        "QAL", "MZ1", "MLA", "PSA", "TO1", "GOA", "IOE", "QVA",
        "BEA", "VBS", "VBS DOM", "REM", "CUF", "IIM", "QZR",
        "VNZ", "BO1", "HNJ", "FIA", "93A", "NC3", "QPZ", "QPA",
        "TV1", "ILJ", "MM1 DOM", "MM1 INT", "ICM", "BRG", "RNV",
        "ISV", "OS3", "AOT", "SKG GRE",
        "IPO", "BA5", "BZQ", "AN6", "ATHC", "DZ5", "RMZ", "PD2",
        "IBU", "DFT", "BO2"
    ];

    // UTILS & SANITIZER
    function sanitize(str) {
        if (!str) return "";
        return str.replace(/[^A-Z0-9]/ig, '').toUpperCase();
    }

    // MOTORE DI RICERCA FLESSIBILE (LENIENT MATCH)
    function isLenientMatch(yosCode, targetCode) {
        if (yosCode === targetCode) return true;
        // Se YOS è "DZ5REL" e target è "DZ5", fa match.
        if (targetCode.length >= 3 && yosCode.startsWith(targetCode)) return true;
        // Caso inverso per sicurezza: se target è "MM1DOM" e YOS è "MM1D", fa match.
        if (yosCode.length >= 3 && targetCode.startsWith(yosCode)) return true;
        return false;
    }

    // SPLUNK PARSER
    function scanSplunkDashboard() {
        const titles = document.querySelectorAll('[data-test="viz-title"]');
        if (titles.length === 0) return;

        let chuteTableContainer = null;

        titles.forEach(t => {
            if (t.textContent.toUpperCase().includes("CHUTE SCANNING EVENTS")) {
                chuteTableContainer = t.closest('[data-test="absolute-item"]') || t.closest('.styled-fullscreen');
            }
        });

        if (chuteTableContainer) {
            const cells = chuteTableContainer.querySelectorAll('td[data-test="cell"][data-col-index="1"]');
            const chuteDestinations = [];

            cells.forEach(cell => {
                const text = cell.textContent.trim().toUpperCase();
                if (text) {
                    const parts = text.split(',').map(p => p.trim());
                    chuteDestinations.push(...parts);
                }
            });

            if (chuteDestinations.length > 0) {
                GM_setValue('splunk_chute_destinations', JSON.stringify(chuteDestinations));
                GM_setValue('splunk_last_heartbeat', Date.now());
            }
        }
    }

    // SPLUNK-YOS COLOR INJECTOR
    function applyYosSplunkColors() {
        const dockingBgs = document.querySelectorAll('.docking_bg, .reverse_docking_bg');
        if (dockingBgs.length === 0) return;

        const splunkDataStr = GM_getValue('splunk_chute_destinations', '[]');
        let rawSplunkDestinations = [];
        try { rawSplunkDestinations = JSON.parse(splunkDataStr); } catch(e){}

        const splunkDestinations = rawSplunkDestinations.map(s => sanitize(s));
        const teoriche = ELENCO_CHUTE_TEORICHE.map(s => sanitize(s));

        dockingBgs.forEach(dockingBg => {
            const doorSpan = dockingBg.querySelector('.door_number span, .reverse_door_number span');
            if (!doorSpan) return;

            const bayNum = parseInt(doorSpan.textContent.trim(), 10);
            if (isNaN(bayNum) || bayNum < 300 || bayNum > 499) return;

            const destDiv = dockingBg.querySelector('.assign_text, .reverse_assign_text');
            if (!destDiv) return;

            const destName = destDiv.textContent.trim().toUpperCase();
            if (destName === "") return;

            let possibleMatches = [sanitize(destName)];

            if (destName.length >= 3) {
                let base = destName.slice(0, -1);
                let suffix = destName.slice(-1);

                if (suffix === 'D') {
                    possibleMatches.push(sanitize(base + ' DOM'));
                } else if (suffix === 'I') {
                    possibleMatches.push(sanitize(base + ' INT'));
                }
            }

            // Ricerca Flessibile invece di includes()
            const isPresentInSplunk = possibleMatches.some(pm =>
                splunkDestinations.some(val => isLenientMatch(pm, val))
            );
            const isPresentInTeorico = possibleMatches.some(pm =>
                teoriche.some(val => isLenientMatch(pm, val))
            );

            if (isPresentInSplunk) {
                dockingBg.style.boxShadow = "inset 0 0 0 5px #28a745";
            } else if (isPresentInTeorico) {
                dockingBg.style.boxShadow = "inset 0 0 0 5px #dc3545";
            } else {
                dockingBg.style.boxShadow = "inset 0 0 0 5px #ffc107";
            }
        });
    }

    // UI: SPLUNK STATUS SU YOS
    function renderSplunkStatus() {
        // Usa l'ID col prefisso tnt- per bypassare YOS TOOL
        let statusBadge = document.getElementById('tnt-splunk-sync-status');
        if (!statusBadge) {
            statusBadge = document.createElement('div');
            statusBadge.id = 'tnt-splunk-sync-status';
            statusBadge.style.cssText = 'position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 999999; padding: 8px 15px; border-radius: 20px; color: white; font-weight: 600; font-family: Roboto, sans-serif; font-size: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.5); display: flex; align-items: center; gap: 8px; pointer-events: none; transition: background-color 0.3s;';
            statusBadge.innerHTML = `<span style="width: 10px; height: 10px; border-radius: 50%; background-color: white; box-shadow: 0 0 5px rgba(255,255,255,0.8);"></span> <span class="sync-text">Splunk in attesa...</span>`;
            document.body.appendChild(statusBadge);
        }

        statusBadge.style.display = 'flex';

        const splunkTrailersStr = GM_getValue('splunk_chute_destinations', '[]');
        let splunkCount = 0;
        try { splunkCount = JSON.parse(splunkTrailersStr).length; } catch(e){}

        const lastHeartbeat = GM_getValue('splunk_last_heartbeat', 0);
        const timeDiff = Date.now() - lastHeartbeat;
        const textEl = statusBadge.querySelector('.sync-text');

        if (lastHeartbeat === 0) {
            statusBadge.style.backgroundColor = '#6c757d'; textEl.innerText = 'SPLUNK: In attesa...';
        } else if (timeDiff < 15000) {
            statusBadge.style.backgroundColor = '#007bff'; textEl.innerText = `SPLUNK ATTIVO (${splunkCount} dest)`;
        } else {
            statusBadge.style.backgroundColor = '#dc3545'; textEl.innerText = `CONNESSIONE SPLUNK PERSA`;
        }
    }

    // HACK: WEB WORKER E ROUTING
    function mainLoop() {
        if (document.querySelector('[data-test="viz-title"]')) {
            scanSplunkDashboard();
        }

        if (document.querySelectorAll('.docking_door_area').length > 0) {
            applyYosSplunkColors();
            renderSplunkStatus();
        } else {
            const status = document.getElementById('tnt-splunk-sync-status');
            if (status) status.style.display = 'none';
        }
    }

    try {
        const workerCode = `
            let interval;
            self.onmessage = function(e) {
                if (e.data === 'start') {
                    interval = setInterval(() => postMessage('tick'), 1000);
                }
            };
        `;
        const blob = new Blob([workerCode], { type: 'application/javascript' });
        const timerWorker = new Worker(URL.createObjectURL(blob));

        timerWorker.onmessage = function() {
            mainLoop();
        };
        timerWorker.postMessage('start');

    } catch (e) {
        setInterval(() => {
            mainLoop();
        }, 1000);
    }

})();
