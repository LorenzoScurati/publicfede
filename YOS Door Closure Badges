    function getClosureOffsetMinutes(dest) {
        if (!dest) return 20;
        if (CLOSURE_RULES[dest] !== undefined) return CLOSURE_RULES[dest];
        for (const key in CLOSURE_RULES) {
            if (dest.startsWith(key)) return CLOSURE_RULES[key];
        }
